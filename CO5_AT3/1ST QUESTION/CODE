# Install packages (run once)
install.packages("plotly")
install.packages("leaflet")
install.packages("dplyr")

# Load libraries
library(plotly)
library(leaflet)
library(dplyr)

# -----------------------------
# DATASET
# -----------------------------
sales <- data.frame(
  Region = c("North","South","East","West",
             "North","South","East","West",
             "North","South","East","West"),
  Category = c("Furniture","Furniture","Furniture","Furniture",
               "Technology","Technology","Technology","Technology",
               "Office Supplies","Office Supplies","Office Supplies","Office Supplies"),
  Sales = c(32000,28500,41000,25500,
            51000,47500,62000,39500,
            21000,19500,27000,17500),
  Month = c("Jan","Jan","Jan","Jan",
            "Feb","Feb","Feb","Feb",
            "Mar","Mar","Mar","Mar")
)

# -----------------------------
# BAR CHART
# -----------------------------
bar_chart <- plot_ly(
  sales,
  x = ~Region,
  y = ~Sales,
  color = ~Region,
  type = "bar"
) %>%
  layout(title = "Sales by Region")

bar_chart

# -----------------------------
# LINE CHART
# -----------------------------
line_chart <- plot_ly(
  sales,
  x = ~Month,
  y = ~Sales,
  color = ~Region,
  type = "scatter",
  mode = "lines+markers"
) %>%
  layout(title = "Monthly Sales Trend")

line_chart

# -----------------------------
# PIE CHART
# -----------------------------
pie_chart <- plot_ly(
  sales,
  labels = ~Category,
  values = ~Sales,
  type = "pie"
) %>%
  layout(title = "Category Sales")

pie_chart

# -----------------------------
# MAP
# -----------------------------
mapdata <- data.frame(
  Region = c("North","South","East","West"),
  Lat = c(28.61,13.08,22.57,19.07),
  Lon = c(77.20,80.27,88.36,72.87),
  Sales = c(104000,95000,130000,82000)
)

leaflet(mapdata) %>%
  addTiles() %>%
  addCircles(
    lng = ~Lon,
    lat = ~Lat,
    radius = ~Sales/80,
    popup = ~paste("Region:", Region, "<br>Sales:", Sales),
    color = "blue",
    fillOpacity = 0.6
  )
