# Dataset
city <- c("Chennai","Bangalore","Hyderabad","Mumbai","Delhi",
          "Pune","Kolkata","Ahmedabad","Jaipur","Kochi")

lat <- c(13.08,12.97,17.38,19.07,28.61,18.52,22.57,23.02,26.91,9.93)
lon <- c(80.27,77.59,78.48,72.87,77.21,73.85,88.36,72.57,75.79,76.26)
pop <- c(11,13,10,20,32,7,15,8,4,2)

# Scatter Map
plot(lon, lat,
     xlab="Longitude",
     ylab="Latitude",
     main="Scatter Map of Cities",
     pch=19)

text(lon, lat, labels=city, pos=3)

# Bubble Map
symbols(lon, lat,
        circles=pop,
        inches=0.3,
        bg="lightblue",
        fg="blue",
        xlab="Longitude",
        ylab="Latitude",
        main="Bubble Map")

text(lon, lat, labels=city, pos=3)

# Highest Population
city[which.max(pop)]
