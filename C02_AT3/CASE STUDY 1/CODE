# Show 5 plots in one window
par(mfrow = c(3,2))

# 1. Bar Plot
barplot(revenue, names.arg=region, col="skyblue",
        main="Bar Plot")

# 2. Stacked Bar Chart
barplot(sales_matrix, names.arg=region,
        col=c("orange","green","purple"),
        main="Stacked Bar Chart")

# 3. Histogram
hist(revenue, col="lightgreen",
     main="Histogram")

# 4. Density Plot
plot(density(revenue), col="blue", lwd=2,
     main="Density Plot")

# 5. Scatter Plot
plot(advertising, revenue, pch=19, col="red",
     main="Scatter Plot")
abline(lm(revenue ~ advertising), col="darkblue", lwd=2)
