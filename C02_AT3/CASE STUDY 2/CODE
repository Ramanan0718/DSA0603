# =====================================================
# CASE STUDY 2 – ALL GRAPHS IN ONE OUTPUT
# University Student Performance Analysis
# =====================================================

# Install package once if not installed
# install.packages("vioplot")

library(vioplot)

# ----------------------
# Sample Data
# ----------------------
department <- c("Computer Science",
                "Information Technology",
                "Electronics",
                "Mechanical")

avg_marks <- c(85, 80, 76, 72)
cgpa <- c(8.9, 8.5, 7.8, 7.2)
placement <- c(95, 90, 80, 70)
attendance <- c(95, 92, 85, 80)

semester <- c(1, 2, 3, 4, 5, 6)
cs_marks <- c(70, 75, 80, 82, 85, 88)

# =====================================================
# DISPLAY ALL GRAPHS IN ONE WINDOW
# =====================================================
par(mfrow = c(3,2), mar = c(4,4,3,1))

# =====================================================
# 1. GROUPED BAR CHART
# =====================================================
barplot(avg_marks,
        names.arg = c("CS", "IT", "ECE", "MECH"),
        col = c("skyblue", "orange", "green", "purple"),
        main = "Department-wise Average Marks",
        xlab = "Department",
        ylab = "Marks")

# =====================================================
# 2. VIOLIN PLOT
# =====================================================
vioplot(cgpa,
        names = "CGPA",
        col = "lightpink",
        main = "Violin Plot of CGPA")

# =====================================================
# 3. HISTOGRAM WITH DENSITY CURVE
# =====================================================
hist(cgpa,
     probability = TRUE,
     col = "lightgreen",
     main = "CGPA Distribution",
     xlab = "CGPA")

lines(density(cgpa),
      col = "blue",
      lwd = 2)

# =====================================================
# 4. SCATTER PLOT
# =====================================================
plot(attendance, cgpa,
     pch = 19,
     col = "red",
     main = "Attendance vs CGPA",
     xlab = "Attendance %",
     ylab = "CGPA")

abline(lm(cgpa ~ attendance),
       col = "darkblue",
       lwd = 2)

# =====================================================
# 5. LINE CHART
# =====================================================
plot(semester, cs_marks,
     type = "l",
     lwd = 2,
     col = "darkgreen",
     main = "Semester-wise Performance Trend",
     xlab = "Semester",
     ylab = "Marks")

points(semester, cs_marks,
       pch = 19,
       col = "blue")

# =====================================================
# 6. PLACEMENT PERCENTAGE (EXTRA GRAPH)
# =====================================================
barplot(placement,
        names.arg = c("CS", "IT", "ECE", "MECH"),
        col = c("gold", "tomato", "cyan", "gray"),
        main = "Placement Percentage",
        xlab = "Department",
        ylab = "Placement %")

# =====================================================
# INTERPRETATION RESULTS
# =====================================================
cat("Highest Average CGPA : ",
    department[which.max(cgpa)], "\n")

cat("Highest Placement Rate : ",
    department[which.max(placement)], "\n")

cat("Correlation between Attendance and CGPA : ",
    round(cor(attendance, cgpa), 2), "\n")
