install.packages("ggplot2")
library(ggplot2)

revenue <- data.frame(
  Product = c("A", "B", "C", "D"),
  Revenue = c(60, 75, 90, 105)
)

print(revenue)

ggplot(revenue, aes(x = Product, y = Revenue)) +
  geom_bar(stat = "identity", width = 0.6, fill = "darkgreen") +
  labs(
    title = "Revenue Comparison",
    x = "Product",
    y = "Revenue (₹ Crores)"
  )

cat("Graphical Error:\\n")
cat("Unequal bar widths create visual distortion.\\n\\n")

cat("Distortion Effect:\\n")
cat("Wider bars appear larger even when the actual revenue difference is smaller.\\n\\n")

cat("Correct Design Principles:\\n")
cat("Use equal-width bars, a consistent scale, and clear axis labels.\\n\\n")

cat("Possible Consequences:\\n")
cat("Investors may overestimate Product D performance and make incorrect investment decisions.\\n")
