install.packages("ggplot2")
library(ggplot2)

students <- data.frame(
  Department = c("Computer Science", "Electronics", "Mechanical", "Civil"),
  Students = c(420, 280, 200, 100)
)

students$Percentage <- round(students$Students / sum(students$Students) * 100, 2)

print(students)

ggplot(students, aes(x = "", y = Students, fill = Department)) +
  geom_col(width = 1) +
  coord_polar(theta = "y") +
  labs(
    title = "Correct Department Enrollment Pie Chart",
    fill = "Department"
  )

ggplot(students, aes(x = Department, y = Students, fill = Department)) +
  geom_bar(stat = "identity") +
  labs(
    title = "Department Enrollment Bar Chart",
    x = "Department",
    y = "Number of Students"
  )

cat("Correct Percentages:\\n")
print(students[, c("Department", "Percentage")])

cat("\\nThe displayed chart is misleading because the slice sizes do not match the actual student percentages.\\n")
cat("A bar chart provides more accurate comparison between departments.\\n")
cat("Incorrect proportions can affect institutional planning, budgeting, faculty allocation, and resource distribution.\\n")
