install.packages("ggplot2")
library(ggplot2)

sales <- data.frame(
  Month = c("January", "February", "March", "April", "May", "June"),
  Sales = c(95, 97, 99, 101, 103, 105)
)

print(sales)

ggplot(sales, aes(x = Month, y = Sales)) +
  geom_bar(stat = "identity", fill = "red") +
  ylim(90, 110) +
  labs(
    title = "Misleading Sales Chart",
    x = "Month",
    y = "Sales (₹ Lakhs)"
  )

ggplot(sales, aes(x = Month, y = Sales)) +
  geom_bar(stat = "identity", fill = "steelblue") +
  ylim(0, 110) +
  labs(
    title = "Improved Sales Chart",
    x = "Month",
    y = "Sales (₹ Lakhs)"
  )

