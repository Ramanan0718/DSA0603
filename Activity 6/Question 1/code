## Question 1 - Two Graphs in One Window

# Data
month <- c("January", "February", "March", "April", "May", "June")
sales <- c(95, 97, 99, 101, 103, 105)

# Show 2 graphs side by side
par(mfrow = c(1, 2))

# -----------------------------
# 1. Misleading Chart
# -----------------------------
barplot(sales,
        names.arg = month,
        col = "red",
        ylim = c(90, 110),
        main = "Misleading Chart",
        ylab = "Sales (₹ Lakhs)")

# -----------------------------
# 2. Corrected Chart
# -----------------------------
barplot(sales,
        names.arg = month,
        col = "steelblue",
        ylim = c(0, 110),
        main = "Corrected Chart",
        ylab = "Sales (₹ Lakhs)")

# Reset layout
par(mfrow = c(1, 1))
