install.packages("ggplot2")
library(ggplot2)

energy <- data.frame(
  Source = c("Solar", "Wind", "Hydro", "Biomass"),
  Energy = c(450, 500, 550, 520)
)

print(energy)

ggplot(energy, aes(x = Source, y = Energy, fill = Source)) +
  geom_bar(stat = "identity") +
  labs(
    title = "Renewable Energy Generation",
    x = "Energy Source",
    y = "Energy (GWh)"
  )

actual_difference <- (550 - 500) / 500 * 100

cat("Why 3D charts are misleading:\\n")
cat("Perspective effects make some bars appear larger than their actual values.\\n\\n")

cat("Perceived Difference:\\n")
cat("Hydro appears about 40% larger than Wind in the 3D chart.\\n\\n")

cat("Actual Difference:\\n")
cat(actual_difference, "%\\n\\n")

cat("Recommended Visualization:\\n")
cat("Use a simple 2D bar chart with a consistent scale and clear labels.\\n\\n")

cat("Importance in Sustainability Reporting:\\n")
cat("Avoiding visual distortion ensures transparent reporting, accurate comparison, and better energy planning decisions.\\n")
