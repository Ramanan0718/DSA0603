install.packages("ggplot2")
library(ggplot2)

cases <- data.frame(
  District = c("A", "B", "C", "D", "E"),
  Cases = c(150, 250, 350, 450, 550)
)

ggplot(cases, aes(x = District, y = Cases, size = sqrt(Cases), color = District)) +
  geom_point(alpha = 0.7) +
  scale_size(range = c(5, 20)) +
  labs(
    title = "Bubble Chart of Disease Cases",
    x = "District",
    y = "Number of Cases",
    size = "Cases"
  ) +
  theme_minimal()
