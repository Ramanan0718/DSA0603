# Monthly Income
income <- c(18000,22000,24000,26000,28000,30000,34000,42000,85000,200000)

# Histogram
hist(income,
     main="Histogram of Monthly Income",
     xlab="Income",
     col="lightgreen")

grid()

# QQ Plot
qqnorm(income,
       main="Normal Q-Q Plot of Income")

qqline(income, col="red", lwd=2)

grid()
