# install.packages("patchwork")
# install.packages("gridExtra")

# Load libraries
library(ggplot2)
library(reshape2)
library(patchwork)
library(gridExtra)

#----------------------------------------------------
# DATASET
#----------------------------------------------------
survey <- data.frame(
  SurveyID = c(1,2,3),
  Q1 = c("A","B","C"),
  Q2 = c("B","A","A"),
  Q3 = c("C","D","B")
)

print(survey)

#----------------------------------------------------
# QUESTION 1 - GROUPED BAR CHART
#----------------------------------------------------
q1_count <- as.data.frame(table(survey$Q1))
colnames(q1_count) <- c("Answer","Count")

p1 <- ggplot(q1_count,
             aes(x = Answer, y = Count, fill = Answer)) +
  geom_bar(stat = "identity", width = 0.6) +
  geom_text(aes(label = Count), vjust = -0.4, size = 5) +
  labs(title = "Question 1 - Grouped Bar Chart",
       x = "Response",
       y = "Count") +
  theme_minimal() +
  theme(legend.position = "none")

#----------------------------------------------------
# QUESTION 2 - STACKED BAR CHART
#----------------------------------------------------
long_data <- melt(survey,
                  id.vars = "SurveyID",
                  variable.name = "Question",
                  value.name = "Response")

stack_data <- as.data.frame(table(long_data$Question,
                                  long_data$Response))
colnames(stack_data) <- c("Question","Response","Count")

p2 <- ggplot(stack_data,
             aes(x = Question, y = Count, fill = Response)) +
  geom_bar(stat = "identity") +
  geom_text(aes(label = Count),
            position = position_stack(vjust = 0.5),
            color = "white",
            size = 4) +
  labs(title = "Question 2 - Stacked Bar Chart",
       x = "Survey Questions",
       y = "Number of Responses") +
  theme_minimal()

#----------------------------------------------------
# QUESTION 3 - TABLE
#----------------------------------------------------
table_plot <- tableGrob(survey)

#----------------------------------------------------
# QUESTION 4 - DASHBOARD
#----------------------------------------------------
dashboard <- (p1 | p2) /
  wrap_elements(full = table_plot)

dashboard <- dashboard +
  plot_annotation(
    title = "SET 10 : SURVEY RESPONSES DASHBOARD",
    theme = theme(
      plot.title = element_text(size = 16,
                                face = "bold",
                                hjust = 0.5)
    )
  )

# Display Dashboard
print(dashboard)
