#====================================================
# SET 12 : WEBSITE TRAFFIC ANALYSIS
# ALL 4 OUTPUTS IN ONE PAGE
#====================================================

# Load Libraries
library(ggplot2)
library(patchwork)
library(gridExtra)

#----------------------------------------------------
# DATASET
#----------------------------------------------------
traffic <- data.frame(
  Date = as.Date(c("2023-01-01","2023-01-02","2023-01-03",
                   "2023-01-04","2023-01-05")),
  PageViews = c(1500,1600,1400,1650,1800),
  CTR = c(2.3,2.7,2.0,2.4,2.6)
)

print(traffic)

#----------------------------------------------------
# QUESTION 1 : LINE CHART
#----------------------------------------------------
p1 <- ggplot(traffic,
             aes(x=Date, y=PageViews, group=1)) +
  geom_line(color="blue", linewidth=1.2) +
  geom_point(color="red", size=3) +
  geom_text(aes(label=PageViews), vjust=-0.8, size=3.5) +
  labs(title="Daily Page Views Trend",
       x="Date",
       y="Page Views") +
  theme_minimal()

#----------------------------------------------------
# QUESTION 2 : BAR CHART (TOP CTR DAYS)
#----------------------------------------------------
top_ctr <- traffic[order(-traffic$CTR), ]

p2 <- ggplot(top_ctr,
             aes(x=reorder(as.character(Date), CTR),
                 y=CTR,
                 fill=CTR)) +
  geom_bar(stat="identity", width=0.6) +
  geom_text(aes(label=paste0(CTR,"%")),
            vjust=-0.5, size=4) +
  labs(title="Top Days by Click Through Rate",
       x="Date",
       y="CTR (%)") +
  theme_minimal() +
  theme(legend.position="none")

#----------------------------------------------------
# QUESTION 3 : TABLE
#----------------------------------------------------
table_plot <- tableGrob(traffic)

#----------------------------------------------------
# QUESTION 4 : DASHBOARD
#----------------------------------------------------
dashboard <- (p1 | p2) /
  wrap_elements(full=table_plot)

dashboard <- dashboard +
  plot_annotation(
    title="SET 12 : WEBSITE TRAFFIC DASHBOARD",
    theme=theme(
      plot.title=element_text(size=16,
                              face="bold",
                              hjust=0.5)
    )
  )

# Display All 4 Outputs in One Page
print(dashboard)
