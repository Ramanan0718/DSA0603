date <- 1:5

likes <- c(200,220,210,230,250)
shares <- c(50,60,55,65,70)
comments <- c(30,35,32,40,45)

interaction <- rbind(likes, shares, comments)

matplot(date,
        t(interaction),
        type="l",
        lty=1,
        lwd=2,
        col=c("blue","red","green"),
        xlab="Day",
        ylab="Interactions",
        main="User Interactions")

legend("topleft",
       legend=c("Likes","Shares","Comments"),
       col=c("blue","red","green"),
       lty=1,
       lwd=2)
