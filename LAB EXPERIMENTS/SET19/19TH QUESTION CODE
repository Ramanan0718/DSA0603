#====================================================
# SET 19 : EMPLOYEE PERFORMANCE ANALYSIS
# ALL 4 OUTPUTS IN ONE PAGE
#====================================================

# Load Libraries
library(ggplot2)
library(patchwork)
library(gridExtra)

#----------------------------------------------------
# DATASET
#----------------------------------------------------
employee <- data.frame(
  EmployeeID = c(1,2,3,4,5),
  Department = c("Sales","HR","Marketing","Sales","HR"),
  YearsService = c(5,3,7,4,2),
  Performance = c(85,92,78,90,76)
)

print(employee)

#----------------------------------------------------
# QUESTION 1 : BAR CHART
# Department Distribution
#----------------------------------------------------
p1 <- ggplot(employee,
             aes(x=Department, fill=Department)) +
  geom_bar() +
  geom_text(stat="count",
            aes(label=after_stat(count)),
            vjust=-0.5, size=5) +
  labs(title="Department Distribution",
       x="Department",
       y="Number of Employees") +
  theme_minimal() +
  theme(legend.position="none")

#----------------------------------------------------
# QUESTION 2 : LINE CHART
# Performance Trend
#----------------------------------------------------
p2 <- ggplot(employee,
             aes(x=EmployeeID,
                 y=Performance,
                 group=1)) +
  geom_line(color="blue", linewidth=1.2) +
  geom_point(color="red", size=3) +
  geom_text(aes(label=Performance),
            vjust=-0.6, size=4) +
  labs(title="Employee Performance Trend",
       x="Employee ID",
       y="Performance Score") +
  theme_minimal()

#----------------------------------------------------
# QUESTION 3 : TABLE
#----------------------------------------------------
table_plot <- tableGrob(employee)

#----------------------------------------------------
# QUESTION 4 : DASHBOARD
#----------------------------------------------------
dashboard <- (p1 | p2) /
  wrap_elements(full=table_plot)

dashboard <- dashboard +
  plot_annotation(
    title="SET 19 : EMPLOYEE PERFORMANCE DASHBOARD",
    theme=theme(
      plot.title=element_text(
        size=16,
        face="bold",
        hjust=0.5
      )
    )
  )

# Display Final Dashboard
print(dashboard)
